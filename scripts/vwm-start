#!/bin/sh
#
# vwm-start -- start a vwm session.  The same as running `vwm`.
#
# Kept so that the three session commands read alike:
#
#   vwm-start    start a session and show it on this terminal
#   vwm-resume   bring the running session to this terminal
#   vwm-stop     end the session
#
# The session runs in the background, apart from this terminal: detach
# with Ctrl-\ (or just close the terminal) and it keeps running.
#
# (Before vwm 8 this script ran vwm under dtach to get that.  vwm does
# it by itself now, and dtach is no longer used.)
#
# Environment:
#   VWM_BIN   path to the vwm binary   (default: vwm, from PATH)

set -u

# --- locate vwm -----------------------------------------------------
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${VWM_BIN:-}" ]; then
    :                                   # caller specified one
elif command -v vwm >/dev/null 2>&1; then
    VWM_BIN=vwm                         # installed, on PATH
elif [ -x "$script_dir/../vwm" ]; then
    VWM_BIN="$script_dir/../vwm"        # running from a build tree
else
    echo "vwm-start: vwm not found." >&2
    exit 1
fi

exec "$VWM_BIN" "$@"
