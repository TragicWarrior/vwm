#!/bin/sh
#
# vwm-stop -- end the running vwm session, from any terminal.
#
# Asks vwm to shut down and waits for it: every program in the session
# is hung up (as if its terminal had been closed), the terminal vwm is
# on -- if any -- is put back the way it was.  Works whether or not a
# terminal is attached, so it is also how to end a session you have
# detached from.
#
# If vwm does not answer, or does not go, it is told more firmly:
# SIGTERM, then SIGKILL.  The exit status is 0 when no session is left
# running.
#
# Usage: vwm-stop [--sid ID]
#   --sid ID   the session started with vwm --sid ID (default: 0)
#
# Environment:
#   VWM_MSG   path to vwm-msg   (default: vwm-msg, from PATH)

set -u

# how long to wait at each stage, in tenths of a second
POLITE_TENTHS=50        # after asking nicely
TERM_TENTHS=30          # after SIGTERM

# --- locate vwm-msg -------------------------------------------------
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${VWM_MSG:-}" ]; then
    :                                   # caller specified one
elif command -v vwm-msg >/dev/null 2>&1; then
    VWM_MSG=vwm-msg                     # installed, on PATH
elif [ -x "$script_dir/../vwm-msg" ]; then
    VWM_MSG="$script_dir/../vwm-msg"    # running from a build tree
else
    echo "vwm-stop: vwm-msg not found." >&2
    exit 1
fi

# --- helpers --------------------------------------------------------

# wait up to $2 tenths of a second for process $1 to go; 0 if it went
# Which session: "--sid ID" (or --sid=ID) picks the one started with
# vwm --sid ID.  With none, the default session -- or the one this
# terminal is inside of, since a session passes its own to what it
# runs.  The id is checked by vwm-msg, which is handed it.
sid=""
while [ $# -gt 0 ]; do
    case "$1" in
        --sid)
            if [ $# -lt 2 ]; then
                echo "vwm-stop: --sid needs a session id" >&2
                exit 1
            fi
            sid=$2
            shift 2
            ;;
        --sid=*)
            sid=${1#--sid=}
            shift
            ;;
        -h|--help)
            echo "Usage: vwm-stop [--sid ID]"
            echo "End the running vwm session, from any terminal."
            exit 0
            ;;
        *)
            echo "vwm-stop: unknown argument '$1'" >&2
            echo "Usage: vwm-stop [--sid ID]" >&2
            exit 1
            ;;
    esac
done

# vwm-msg for the chosen session
msg() {
    if [ -n "$sid" ]; then
        "$VWM_MSG" --sid "$sid" "$@"
    else
        "$VWM_MSG" "$@"
    fi
}

# how to name the session in a message, and in a command to suggest
if [ -n "$sid" ]; then
    which="vwm session '$sid'"
    opt=" --sid $sid"
else
    which="vwm session"
    opt=""
fi

wait_gone() {
    n=0
    while kill -0 "$1" 2>/dev/null; do
        n=$((n + 1))
        [ "$n" -gt "$2" ] && return 1
        sleep 0.1
    done
    return 0
}

# --- is there a session? --------------------------------------------
ping=$(msg ping 2>/dev/null) || ping=""

case "$ping" in
    *'"ok":true'*) ;;
    *)
        echo "No $which is running."
        exit 0
        ;;
esac

# the pid comes from vwm itself, so it is the right one even when
# several programs named vwm exist
pid=$(printf '%s' "$ping" | sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p')

# --- ask nicely -----------------------------------------------------
msg stop >/dev/null 2>&1 || true

if [ -z "$pid" ]; then
    # a vwm too old to say who it is: it was asked, and that is all
    # that can be done without guessing at process names
    echo "Asked vwm to stop."
    exit 0
fi

if wait_gone "$pid" "$POLITE_TENTHS"; then
    echo "vwm stopped."
    exit 0
fi

# --- insist ---------------------------------------------------------
echo "vwm (pid $pid) is still running; sending SIGTERM."
kill -TERM "$pid" 2>/dev/null || true

if wait_gone "$pid" "$TERM_TENTHS"; then
    echo "vwm stopped."
    exit 0
fi

echo "vwm (pid $pid) did not respond; sending SIGKILL."
kill -KILL "$pid" 2>/dev/null || true

if wait_gone "$pid" 20; then
    echo "vwm killed.  Programs it was running may need a moment to exit."
    exit 0
fi

echo "vwm-stop: could not stop vwm (pid $pid)." >&2
exit 1
