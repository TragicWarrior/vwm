#!/bin/sh
#
# vwm-resume -- bring the running vwm session to this terminal.
#
# The session comes here, and this command stays as the terminal's
# foreground job until the session leaves again -- it was detached, it
# moved to another terminal, or it ended -- and then says which.  A
# terminal the session was showing on gets its shell back.
#
# vwm is told what this terminal is (its tty and $TERM), so it drives it
# as the right terminal type and, on a Linux console, picks up the GPM
# mouse for this console.
#
# If no session is running, start one with vwm.
#
# Detach key while attached:  Ctrl-\
#
# Environment:
#   VWM_MSG   path to vwm-msg   (default: vwm-msg, from PATH)

set -u

# --- locate vwm-msg -------------------------------------------------
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${VWM_MSG:-}" ]; then
    :                                   # caller specified one
elif command -v vwm-msg >/dev/null 2>&1; then
    VWM_MSG=vwm-msg                     # installed, on PATH
elif [ -x "$script_dir/../vwm-msg" ]; then
    VWM_MSG="$script_dir/../vwm-msg"    # running from a build tree
else
    echo "vwm-resume: vwm-msg not found." >&2
    exit 1
fi

# --- what is this terminal? -----------------------------------------
here=$(tty 2>/dev/null) || here=""
case "$here" in
    /dev/*) ;;
    *)
        echo "vwm-resume: not on a terminal." >&2
        exit 1
        ;;
esac

# --- is there a session? --------------------------------------------
if ! "$VWM_MSG" ping >/dev/null 2>&1; then
    echo "No vwm session is running."
    echo "Start one with:  vwm"
    exit 1
fi

# --- bring it here --------------------------------------------------
# vwm-msg attach asks the session over and then waits, holding this
# terminal for it, until the session leaves; it says why and sees that
# the terminal is left in order.
exec "$VWM_MSG" attach --tty "$here" --term "${TERM:-}"
